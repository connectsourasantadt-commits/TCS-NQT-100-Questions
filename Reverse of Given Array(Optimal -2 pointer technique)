C++ Code-
#include<iostream>
using namespace std;
int main(){
    int arr[]={5,4,3,2,1};
    int n= sizeof(arr)/sizeof(arr[0]);// element number/size of array
    //declare the pointer
    int left=0;
    int right= n-1;
    //let start moving with the pointer
    while(left<right)
    {
        int temp=arr[left]; //temp value of left pointer position
        arr[left]=arr[right]; //swapping values
        arr[right]= temp; //this now new values
        //move the pointer
        left++;
        right--;
    }
    cout << "Reversed array optimally";
    for(int i =0; i<n; i++){
        cout<<arr[i]<<"";
    }
    return 0;
}

