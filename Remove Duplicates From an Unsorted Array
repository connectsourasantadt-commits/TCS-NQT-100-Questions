#include <iostream>         // For input and output (cout)
#include <vector>           // For using vector (dynamic array)
#include <unordered_set>    // For using unordered_set (stores unique values)

using namespace std;

int main() {

    // Original array with duplicate elements
    vector<int> arr = {2,3,1,9,3,1,3,9};

    // This vector will store final unique elements
    vector<int> ans;

    // Set is used to check whether element already exists or not
    unordered_set<int> st;

    // Traverse the entire array one by one
    for(int i = 0; i < arr.size(); i++) {

        // Check if current element is NOT present inside set
        // st.find(arr[i])  -> searches the element
        // st.end()         -> means element not found
        if(st.find(arr[i]) == st.end()) {

            // Insert current element into set
            // So next time if same element comes,
            // we can identify it as duplicate
            st.insert(arr[i]);

            // Add unique element into answer vector
            ans.push_back(arr[i]);
        }
    }

    // Print all unique elements
    for(int x : ans) {

        // Print element followed by space
        cout << x << " ";
    }

    // Program ended successfully
    return 0;
}
