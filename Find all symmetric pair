#include<iostream>
#include<vector>
#include<unordered_map>
using namespace std;

int main(){

    vector<pair<int,int>> arr = {
        {1,2},
        {2,1},
        {3,4},
        {4,5},
        {5,4}
    };

    // HashMap
    unordered_map<int,int> mp;

    // Traverse all pairs
    for(auto p : arr){

        // Current pair values
        int first = p.first;
        int second = p.second;

        // Check reverse pair exists
        if(mp.find(second) != mp.end()
           && mp[second] == first){

            cout << "("
                 << first
                 << ","
                 << second
                 << ") ";
        }

        // Store current pair
        mp[first] = second;
    }

    return 0;
}
