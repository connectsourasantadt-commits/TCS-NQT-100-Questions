# Given array
arr = [10, 5, 10, 15, 10, 5]

n = len(arr)

# Create visited list
visited = [False] * n

# Traverse array
for i in range(n):

    # Skip if already counted
    if visited[i] == True:
        continue

    # Frequency starts from 1
    count = 1

    # Check duplicates
    for j in range(i + 1, n):

        # Same element found
        if arr[i] == arr[j]:
            count += 1

            # Mark duplicate visited
            visited[j] = True

    # Print result
    print(arr[i], count)
