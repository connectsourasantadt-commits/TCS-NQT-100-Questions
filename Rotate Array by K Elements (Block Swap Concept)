C++--

#include <iostream>
using namespace std;

int main()
{
    int arr[] = {1,2,3,4,5};

    int n = 5;
    int k = 2;

    // Temporary array
    int temp[k];

    // Store first k elements
    for(int i = 0; i < k; i++)
    {
        temp[i] = arr[i];
    }

    // Shift remaining elements left
    for(int i = k; i < n; i++)
    {
        arr[i-k] = arr[i];
    }

    // Put temp elements at end
    for(int i = 0; i < k; i++)
    {
        arr[n-k+i] = temp[i];
    }

    // Print array
    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    return 0;
}


