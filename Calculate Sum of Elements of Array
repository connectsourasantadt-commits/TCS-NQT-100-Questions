C++ --

#include <iostream>
using namespace std;

int main()
{
    // Given array
    int arr[] = {1, 2, 3, 4, 5};

    // Size of array
    int n = sizeof(arr) / sizeof(arr[0]);

    // Variable to store sum
    int sum = 0;

    // Traverse array
    for(int i = 0; i < n; i++)
    {
        // Add current element to sum
        sum = sum + arr[i];
    }

    // Print final sum
    cout << "Sum = " << sum;

    return 0;
}

