C++ Code- 
#include <iostream>
#include<algorithm>
using namespace std;
int main() {
    int arr[]= {1,2,3,4,5,6};
    int n= sizeof(arr)/sizeof(arr[0]);
    int sum=0;
    for (int i=0; i<n; i++){
        sum=sum+arr[i];
    }
    int avg= sum/n;
    cout<< avg;

    return 0;
}

