#include<iostream>
#include<algorithm>
using namespace std;
int main() {
    int arr[]= {5,3,2,3};
    int n = sizeof(arr)/sizeof(arr[0]);
    int sum=0;
    for (int i=0;i<n;i++){
        sum=sum+arr[i];
    }
    int avg=sum/n;
    sort(arr,arr+n);
    if(n%2==0){
        cout << "the median element is"<< n/2 << endl;
    }
    else {
        cout << avg;
    }
    return 0;
}

